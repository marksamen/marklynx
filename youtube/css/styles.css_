  :root{
    --bg: #000000;
    --bg-raised: #141414;
    --bg-card: #161616;
    --line: #262626;
    --red: #b3231c;
    --red-bright: #e0392f;
    --silver: #c9c9c9;
    --text: #e8e6e2;
    --text-dim: #8a8a8a;
    --serif: "Cormorant Garamond", "Iowan Old Style", Georgia, serif;
    --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--sans);}
  ::selection{background:var(--red); color:#fff;}

  a{color:inherit;}

  /* ---------- Banner ---------- */
  .banner-wrap{
    width:100%;
    background:#000;
    display:flex;
    justify-content:center;
    overflow:hidden;
    position:relative;
  }

  .banner-wrap::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(calc(100% - 56px), 1400px);
    border-bottom:2px solid var(--red);
  }
  .banner-wrap img{
    display:block;
    width:100%;
    max-width:1707px;
    height:auto;
  }


  /* ---------- YouTube Subscribe ---------- */
  .subscribe-strip{
    background:var(--bg);
    padding:9px 28px;
    position:relative;
  }

  .subscribe-strip-inner{
    max-width:1400px;
    margin:0 auto;
    display:flex;
    justify-content:flex-end;
  }
  .youtube-subscribe-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:#b32020;
    border:1px solid #8f1a1a;
    color:#fff;
    padding:9px 14px;
    border-radius:3px;
    font-size:13px;
    font-weight:700;
    font-family:var(--sans);
    text-decoration:none;
    white-space:nowrap;
    transition:background .15s, border-color .15s;
  }
  .youtube-subscribe-btn:hover{
    background:#9d1b1b;
    border-color:#7f1515;
  }
  .youtube-subscribe-btn svg{
    width:18px;
    height:18px;
    fill:#fff;
    flex-shrink:0;
  }

  /* ---------- Toolbar ---------- */
  .toolbar{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(0,0,0,0.96);
    backdrop-filter:blur(6px);
    padding:18px 28px;
  }

  .toolbar::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(calc(100% - 56px), 1400px);
    border-bottom:1px solid var(--line);
  }
  .toolbar-inner{
    max-width:1400px;
    margin:0 auto;
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
  }
  .search-box{
    flex:1 1 240px;
    min-width:220px;
    position:relative;
    display:flex;
    align-items:center;
  }
  .search-box svg{
    position:absolute;
    left:14px;
    width:16px;
    height:16px;
    stroke:var(--text-dim);
    pointer-events:none;
  }
  .search-box input{
    width:100%;
    background:var(--bg-raised);
    border:1px solid var(--line);
    color:var(--text);
    padding:11px 14px 11px 38px;
    border-radius:3px;
    font-size:15px;
    font-family:var(--sans);
    transition:border-color .15s;
  }
  .search-box input:focus{
    outline:none;
    border-color:var(--red);
  }
  .search-box input::placeholder{color:var(--text-dim);}

  select{
    background:var(--bg-raised);
    border:1px solid var(--line);
    color:var(--text);
    padding:10px 12px;
    border-radius:3px;
    font-size:14px;
    font-family:var(--sans);
    cursor:pointer;
  }
  select:focus{outline:none; border-color:var(--red);}

  .view-toggle{
    display:flex;
    border:1px solid var(--line);
    border-radius:3px;
    overflow:hidden;
    flex-shrink:0;
  }
  .view-toggle button{
    background:var(--bg-raised);
    border:none;
    color:var(--text-dim);
    padding:10px 14px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:6px;
    font-size:13px;
    font-family:var(--sans);
    transition:background .15s, color .15s;
  }
  .view-toggle button.active{
    background:var(--red);
    color:#fff;
  }
  .view-toggle button:not(.active):hover{
    background:#1e1e1e;
    color:var(--text);
  }
  .view-toggle svg{width:15px;height:15px;stroke:currentColor;fill:none;}

  .suggest-btn{
    display:inline-flex;
    align-items:center;
    gap:7px;
    background:var(--red);
    border:1px solid var(--red);
    color:#fff;
    padding:10px 16px;
    border-radius:3px;
    font-size:13px;
    font-weight:600;
    font-family:var(--sans);
    text-decoration:none;
    white-space:nowrap;
    transition:background .15s, border-color .15s;
    flex-shrink:0;
  }
  .suggest-btn:hover{
    background:var(--red-bright);
    border-color:var(--red-bright);
  }
  .suggest-btn svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}

  .clear-filters-btn{
    display:none;
    align-items:center;
    gap:7px;
    background:transparent;
    border:1px solid var(--line);
    color:var(--text-dim);
    padding:10px 14px;
    border-radius:3px;
    font-size:13px;
    font-family:var(--sans);
    white-space:nowrap;
    cursor:pointer;
    transition:background .15s, border-color .15s, color .15s;
    flex-shrink:0;
  }
  .clear-filters-btn:hover{background:#1e1e1e;border-color:var(--red);color:#fff;}
  .clear-filters-btn.visible{display:inline-flex;}

  .count-line{
    max-width:1400px;
    margin:14px auto 0;
    padding:0 28px;
    font-size:13px;
    color:var(--text-dim);
    letter-spacing:.02em;
  }
  .count-line strong{color:var(--red-bright); font-weight:600;}

  /* ---------- Container ---------- */
  .container{
    max-width:1400px;
    margin:0 auto;
    padding:18px 28px 60px;
  }

  /* ---------- Grid view ---------- */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));
    gap:20px;
  }
  .card{
    background:var(--bg-card);
    border:1px solid var(--line);
    border-radius:4px;
    overflow:hidden;
    display:flex;
    flex-direction:column;
    transition:border-color .15s, transform .15s;
  }
  .card:hover{
    border-color:var(--red);
    transform:translateY(-2px);
  }
  .thumb-wrap{
    position:relative;
    width:100%;
    aspect-ratio:16/9;
    background:#000;
    overflow:hidden;
    display:block;
  }
  .thumb-wrap img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .3s;
  }
  .card:hover .thumb-wrap img{transform:scale(1.05);}
  .play-badge{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(0,0,0,0);
    transition:background .15s;
  }
  .play-badge svg{
    width:44px;height:44px;
    opacity:0;
    transition:opacity .15s;
    filter:drop-shadow(0 2px 6px rgba(0,0,0,.6));
  }
  .card:hover .play-badge{background:rgba(0,0,0,.25);}
  .card:hover .play-badge svg{opacity:1;}

  .gs-pill{
    position:absolute;
    top:8px;
    right:8px;
    background:rgba(0,0,0,.75);
    border:1px solid var(--red);
    color:var(--red-bright);
    font-size:11px;
    font-weight:600;
    padding:3px 8px;
    border-radius:20px;
    letter-spacing:.02em;
  }
  .playlist-pill{
    position:absolute;
    top:8px;
    left:8px;
    background:rgba(0,0,0,.75);
    border:1px solid var(--silver);
    color:var(--silver);
    font-size:11px;
    font-weight:600;
    padding:3px 8px;
    border-radius:20px;
    letter-spacing:.02em;
    display:flex;
    align-items:center;
    gap:4px;
  }
  .playlist-pill svg{width:10px;height:10px;fill:currentColor;}
  .adult-pill{
    position:absolute;right:7px;top:7px;z-index:3;
    display:inline-flex;align-items:center;gap:4px;
    padding:3px 7px;border-radius:999px;
    background:rgba(160,20,20,.94);border:1px solid rgba(255,255,255,.18);
    color:#fff;font-size:10px;font-weight:800;letter-spacing:.25px;
    box-shadow:0 2px 8px rgba(0,0,0,.35);
  }

  .kinect-badge{
    display:inline-flex;
    align-items:center;
    gap:4px;
    font-size:10.5px;
    font-weight:700;
    color:#d9ecff;
    background:rgba(70,130,180,.12);
    border:1px solid #456b8a;
    padding:2px 7px;
    border-radius:20px;
    white-space:nowrap;
  }

  .text-guide-badge{
    display:inline-flex;
    align-items:center;
    gap:4px;
    font-size:10.5px;
    color:var(--silver);
    background:rgba(201,201,201,.08);
    border:1px solid #3a3a3a;
    padding:2px 7px;
    border-radius:20px;
    white-space:nowrap;
  }
  .text-guide-badge svg{width:10px;height:10px;stroke:currentColor;fill:none;flex-shrink:0;}
  .badge-row{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:2px;
  }

  .quality-badge{
    display:inline-block;
    width:58px;
    height:auto;
    vertical-align:middle;
    object-fit:contain;
  }
  .list-col.quality .quality-badge{width:64px;}
  .mobile-quality-badge{display:none;}

  .card-body{
    padding:12px 14px 14px;
    display:flex;
    flex-direction:column;
    gap:6px;
    flex:1;
  }
  .card-title{
    font-family:var(--serif);
    font-size:19px;
    font-weight:600;
    line-height:1.25;
    color:var(--text);
    margin:0;
  }
  .card-meta{
    font-size:12px;
    color:var(--text-dim);
    display:flex;
    flex-wrap:wrap;
    gap:6px 10px;
    margin-top:2px;
  }
  .card-meta span{white-space:nowrap;}
  .diff-tag{
    display:inline-block;
    margin-top:auto;
    padding-top:8px;
    font-size:11px;
    text-transform:none;
  }
  .diff-dot{
    display:inline-block;
    width:7px;height:7px;
    border-radius:50%;
    margin-right:6px;
    vertical-align:middle;
  }

  /* ---------- List view ---------- */
  .list{
    display:flex;
    flex-direction:column;
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
    border-radius:4px;
    overflow:hidden;
  }
  .list-row{
    display:grid;
    grid-template-columns:120px 1fr auto auto auto auto auto;
    align-items:center;
    gap:16px;
    background:var(--bg-card);
    padding:10px 16px;
    text-decoration:none;
    color:var(--text);
    transition:background .15s;
  }
  .list-row:hover{background:#1c1414;}
  .list-thumb{
    position:relative;
    width:110px;
    aspect-ratio:16/9;
    border-radius:3px;
    overflow:hidden;
    background:#000;
    flex-shrink:0;
  }
  .list-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  .list-name{
    font-family:var(--serif);
    font-size:18px;
    font-weight:600;
  }
  .list-sub{
    font-size:12px;
    color:var(--text-dim);
    margin-top:2px;
  }
  .list-col{
    font-size:13px;
    color:var(--text-dim);
    text-align:right;
    white-space:nowrap;
  }
  .list-col.gs{color:var(--red-bright); font-weight:600;}
  .list-head{
    display:grid;
    grid-template-columns:120px 1fr auto auto auto auto auto;
    gap:16px;
    padding:0 16px 8px;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--text-dim);
  }
  .list-head span{text-align:right;}
  .list-head span:first-child, .list-head span:nth-child(2){text-align:left;}

  /* ---------- Empty state ---------- */
  .empty{
    text-align:center;
    padding:80px 20px;
    color:var(--text-dim);
  }
  .empty h3{
    font-family:var(--serif);
    color:var(--silver);
    font-size:24px;
    margin-bottom:8px;
  }

  /* ---------- Load more ---------- */
  .load-more-wrap{
    display:flex;
    justify-content:center;
    padding:30px 0 10px;
  }
  .load-more{
    background:transparent;
    border:1px solid var(--red);
    color:var(--red-bright);
    padding:12px 28px;
    border-radius:3px;
    font-size:13px;
    letter-spacing:.05em;
    cursor:pointer;
    font-family:var(--sans);
    transition:background .15s, color .15s;
  }
  .load-more:hover{background:var(--red); color:#fff;}

  footer{
    text-align:center;
    padding:26px 20px 40px;
    color:var(--text-dim);
    font-size:12px;
    position:relative;
  }
  footer::before{
    content:"";
    position:absolute;
    left:50%;
    top:0;
    transform:translateX(-50%);
    width:min(calc(100% - 56px), 1400px);
    border-top:1px solid var(--line);
  }
  footer span{color:var(--red-bright);}
  .footer-stats{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:8px 22px;
    margin-bottom:10px;
  }
  .footer-stats strong{color:var(--red-bright); font-weight:700;}

  /* ---------- Video Modal ---------- */
  .video-modal-overlay{
    display:none;
    position:fixed;
    inset:0;
    z-index:200;
    background:rgba(0,0,0,.88);
    align-items:center;
    justify-content:center;
    padding:24px;
  }
  .video-modal-overlay.open{display:flex;}
  .video-modal{
    background:var(--bg-card);
    border:1px solid var(--red);
    border-radius:6px;
    width:100%;
    max-width:1100px;
    max-height:90vh;
    display:flex;
    overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,.6);
  }
  .video-modal-main{
    flex:1 1 auto;
    display:flex;
    flex-direction:column;
    min-width:0;
  }
  .video-modal-player{
    position:relative;
    width:100%;
    aspect-ratio:16/9;
    background:#000;
  }
  .video-modal-player > div{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
  }
  .video-modal-player iframe{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    border:0;
  }
  .video-modal-info{
    padding:14px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
  }
  .video-modal-title{
    font-family:var(--serif);
    font-size:20px;
    font-weight:600;
  }
  .video-modal-close{
    background:transparent;
    border:1px solid var(--line);
    color:var(--text-dim);
    width:32px;
    height:32px;
    border-radius:4px;
    cursor:pointer;
    flex-shrink:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:16px;
    transition:border-color .15s, color .15s;
  }
  .video-modal-close:hover{border-color:var(--red); color:var(--red-bright);}
  .video-modal-sidebar{
    width:280px;
    flex-shrink:0;
    border-left:1px solid var(--line);
    overflow-y:auto;
    max-height:90vh;
  }
  .video-modal-sidebar-head{
    padding:12px 14px;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--text-dim);
    border-bottom:1px solid var(--line);
    position:sticky;
    top:0;
    z-index:2;
    background:var(--bg-card);
  }
  .playlist-loading{
    padding:18px 14px;
    color:var(--text-dim);
    font-size:12px;
    text-align:center;
  }
  .playlist-item-meta{
    min-width:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  .playlist-item-number{
    font-size:10px;
    color:var(--text-dim);
    margin-bottom:3px;
  }
  .playlist-item{
    display:flex;
    gap:10px;
    padding:10px 14px;
    cursor:pointer;
    border-bottom:1px solid var(--line);
    transition:background .15s;
  }
  .playlist-item:hover{background:#1c1414;}
  .playlist-item.active{background:rgba(179,35,28,.18); border-left:3px solid var(--red);}
  .playlist-item-thumb{
    width:88px;
    aspect-ratio:16/9;
    border-radius:3px;
    overflow:hidden;
    flex-shrink:0;
    background:#000;
  }
  .playlist-item-thumb img{width:100%;height:100%;object-fit:cover;display:block;}
  .playlist-item-title{
    font-size:12.5px;
    line-height:1.35;
    color:var(--text);
  }
  @media (max-width:720px){
    .video-modal{flex-direction:column; max-height:95vh;}
    .video-modal-sidebar{width:100%; max-height:220px; border-left:0; border-top:1px solid var(--line);}
  }

  /* Keep list view compact on phones in both portrait and landscape. */
  @media (max-width:900px){
    .mobile-quality-badge{
      display:block;
      margin-top:6px;
      line-height:1;
    }
    .mobile-quality-badge .quality-badge{width:54px;}
    .list-row, .list-head{
      grid-template-columns:88px minmax(0,1fr) auto;
      gap:10px;
    }
    .list-thumb{width:88px;}
    .list-row > span:nth-child(2){min-width:0;}
    .list-name, .list-sub{overflow-wrap:anywhere;}
    .list-col.time, .list-col.type, .list-col.diff, .list-col.quality,
    .list-head .h-time, .list-head .h-type, .list-head .h-diff, .list-head .h-quality{display:none;}
  }

  @media (max-width:640px){
    .banner-wrap::after,
    .toolbar::after,
    footer::before{
      width:calc(100% - 28px);
    }
    .list-row{padding:10px;}
    .list-head{padding-left:10px;padding-right:10px;}
    .list-name{font-size:16px;line-height:1.2;}
    .list-sub{font-size:11px;line-height:1.25;}
    .toolbar{padding:14px;}
    .container{padding:14px 14px 40px;}
  }

/* Recent Uploads */
.recent-uploads{
  width:100%;
  margin:12px auto 24px;
}
.recent-uploads-inner{
  max-width:1400px;
  margin:0 auto;
  padding:0 28px 24px;
  border-bottom:1px solid var(--line);
}
.recent-uploads-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  margin:0 0 12px;
}
.recent-uploads-head h2{
  margin:0;
  font-size:22px;
  line-height:1.2;
}

/* Grid mode: visual, thumbnail-only browsing. */
.recent-uploads-grid.grid-mode{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
}
.recent-uploads-grid.grid-mode .recent-upload-title{
  display:none;
}
.recent-upload-card{
  appearance:none;
  width:100%;
  padding:0;
  border:0;
  background:transparent;
  color:var(--text);
  text-align:left;
  cursor:pointer;
  font:inherit;
}
.recent-upload-thumb{
  display:block;
  position:relative;
  width:100%;
  aspect-ratio:16/9;
  overflow:hidden;
  border-radius:8px;
  background:#111;
}
.recent-upload-thumb img{
  display:block;
  width:100%;
  height:100%;
  object-fit:cover;
  transition:transform .15s ease;
}
.recent-upload-card:hover .recent-upload-thumb img{
  transform:scale(1.025);
}

/* List mode: compact rows using only the useful part of the YouTube title. */
.recent-uploads-grid.list-mode{
  display:flex;
  flex-direction:column;
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
  border-radius:4px;
  overflow:hidden;
}
.recent-uploads-grid.list-mode .recent-upload-card{
  display:grid;
  grid-template-columns:92px minmax(0,1fr) auto auto auto auto auto;
  align-items:center;
  gap:12px;
  padding:6px 12px;
  background:var(--bg-card);
  transition:background .15s;
}
.recent-uploads-grid.list-mode .recent-upload-card:hover{
  background:#1c1414;
}
.recent-uploads-grid.list-mode .recent-upload-thumb{
  width:92px;
  border-radius:3px;
}
.recent-upload-title{
  display:block;
  min-width:0;
  font-family:var(--serif);
  font-size:16px;
  line-height:1.25;
  font-weight:600;
  overflow-wrap:anywhere;
}

.recent-upload-meta{
  font-size:13px;
  color:var(--text-dim);
  text-align:right;
  white-space:nowrap;
}
.recent-upload-meta.gs{
  color:var(--red-bright);
  font-weight:600;
}
.recent-upload-meta.quality{
  display:flex;
  justify-content:flex-end;
  align-items:center;
}
.recent-upload-meta.quality .quality-badge{
  width:58px;
}
.recent-uploads-grid.list-mode .recent-upload-meta{
  display:block;
}
.recent-uploads-grid.grid-mode .recent-upload-meta{
  display:none;
}

@media (max-width:900px){
  .recent-uploads-grid.grid-mode{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  .recent-uploads-grid.list-mode .recent-upload-card{
    grid-template-columns:80px minmax(0,1fr);
    gap:10px;
    padding:6px 10px;
  }
  .recent-upload-meta{
    display:none;
  }
  .recent-uploads-grid.list-mode .recent-upload-thumb{
    width:80px;
  }
  .recent-upload-title{
    font-size:15px;
  }
}

@media (max-width:640px){
  .recent-uploads-inner{
    padding:0 14px 18px;
  }
  .recent-uploads-grid.grid-mode{
    gap:12px 8px;
  }
  .recent-uploads-head h2{
    font-size:19px;
  }
  .recent-uploads-grid.list-mode .recent-upload-card{
    padding:5px 8px;
    grid-template-columns:72px minmax(0,1fr);
  }
  .recent-uploads-grid.list-mode .recent-upload-thumb{
    width:72px;
  }
}


@media (max-width:900px){
  .recent-uploads-grid.list-mode .recent-upload-card{
    grid-template-columns:92px minmax(0,1fr);
  }

  .recent-uploads-grid.list-mode .recent-upload-meta,
  .recent-uploads-grid.list-mode .recent-upload-meta.quality{
    display:none !important;
  }
}


/* Desktop Recent Uploads grid: keep all metadata visible without changing mobile. */
@media (min-width:901px){
  .recent-uploads-grid.grid-mode .recent-upload-card{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:6px 10px;
  }

  .recent-uploads-grid.grid-mode .recent-upload-thumb{
    flex:0 0 100%;
  }

  .recent-uploads-grid.grid-mode .recent-upload-title{
    display:block;
    flex:0 0 100%;
    margin-top:2px;
  }

  .recent-uploads-grid.grid-mode .recent-upload-meta{
    display:inline-flex;
    align-items:center;
    text-align:left;
    white-space:nowrap;
  }

  .recent-uploads-grid.grid-mode .recent-upload-meta.quality{
    justify-content:flex-start;
  }
}


/* Hide Recent Uploads while the visitor is actively searching/filtering/sorting. */
body.guide-filter-active .recent-uploads{
  display:none !important;
}
